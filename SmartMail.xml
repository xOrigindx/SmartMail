          </OnClick>
        </Scripts>
      </Button>
    </Frames>
    <Scripts>
      <OnLoad>
        this:RegisterForDrag("LeftButton")
      </OnLoad>
      <OnDragStart>
        this:StartMoving()
      </OnDragStart>
      <OnDragStop>
        this:StopMovingOrSizing()
      </OnDragStop>
    </Scripts>
  </Frame>

