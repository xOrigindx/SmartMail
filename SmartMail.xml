<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ../FrameXML/UI.xsd">

  <Button name="SmartMailToggleButton" parent="MailFrame" inherits="UIPanelButtonTemplate"
    text="SmartMail">
    <Size x="85" y="22" />
    <Anchors>
      <Anchor point="TOPRIGHT" relativeTo="MailFrame" relativePoint="TOPRIGHT">
        <Offset x="-75" y="-14" />
      </Anchor>
    </Anchors>
    <Scripts>
      <OnClick>
        if SmartMailMainFrame:IsVisible() then
          SmartMailMainFrame:Hide()
        else
          SmartMailMainFrame:Show()
        end
      </OnClick>
    </Scripts>
  </Button>

  <!-- SmartMail Main Window -->
  <Frame name="SmartMailMainFrame" toplevel="true" parent="UIParent" movable="true"
    enableMouse="true" hidden="true">
    <Size x="320" y="420" />
    <Anchors>
      <Anchor point="TOPLEFT" relativeTo="MailFrame" relativePoint="TOPRIGHT">
        <Offset x="10" y="0" />
      </Anchor>
    </Anchors>
    <Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background"
      edgeFile="Interface\DialogFrame\UI-DialogBox-Border" tile="true">
      <BackgroundInsets left="11" right="12" top="12" bottom="11" />
      <TileSize val="32" />
      <EdgeSize val="32" />
    </Backdrop>

    <Layers>
      <Layer level="ARTWORK">
        <Texture name="$parentHeader" file="Interface\DialogFrame\UI-DialogBox-Header">
          <Size x="256" y="64" />
          <Anchors>
            <Anchor point="TOP">
              <Offset x="0" y="12" />
            </Anchor>
          </Anchors>
        </Texture>
        <FontString name="$parentTitle" inherits="GameFontNormal" text="SmartMail">
          <Anchors>
            <Anchor point="TOP" relativeTo="$parentHeader">
              <Offset x="0" y="-14" />
            </Anchor>
          </Anchors>
        </FontString>
      </Layer>
    </Layers>

    <Frames>
      <Button name="$parentCloseButton" inherits="UIPanelCloseButton">
        <Anchors>
          <Anchor point="TOPRIGHT">
            <Offset x="-5" y="-5" />
          </Anchor>
        </Anchors>
        <Scripts>
          <OnClick>
            this:GetParent():Hide()
          </OnClick>
        </Scripts>
      </Button>

      <!-- Top Row -->
      <Button name="$parentAddButton" inherits="UIPanelButtonTemplate" text="Add">
        <Size x="80" y="24" />
        <Anchors>
          <Anchor point="TOPLEFT">
            <Offset x="20" y="-40" />
          </Anchor>
        </Anchors>
        <Scripts>
          <OnClick>
            SmartMail_OpenProfileEditor(nil)
          </OnClick>
        </Scripts>
      </Button>

      <Button name="$parentDeleteButton" inherits="UIPanelButtonTemplate" text="Delete">
        <Size x="80" y="24" />
        <Anchors>
          <Anchor point="TOP">
            <Offset x="0" y="-40" />
          </Anchor>
        </Anchors>
        <Scripts>
          <OnClick>
            if SmartMail.selectedProfile then
                SmartMail_DeleteProfile(SmartMail.selectedProfile)
            end
          </OnClick>
        </Scripts>
      </Button>

      <Button name="$parentEditButton" inherits="UIPanelButtonTemplate" text="Edit">
        <Size x="80" y="24" />
        <Anchors>
          <Anchor point="TOPRIGHT">
            <Offset x="-20" y="-40" />
          </Anchor>
        </Anchors>
        <Scripts>
          <OnClick>
            if SmartMail.selectedProfile then
                SmartMail_OpenProfileEditor(SmartMail.selectedProfile)
            end
          </OnClick>
        </Scripts>
      </Button>


      <!-- Character Name Area -->
      <Frame name="$parentListFrame" enableMouse="true">
        <Size x="280" y="220" />
        <Anchors>
          <Anchor point="TOP" relativeTo="$parentDeleteButton" relativePoint="BOTTOM">
            <Offset x="0" y="-10" />
          </Anchor>
        </Anchors>
        <Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background"
          edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
          <BackgroundInsets left="4" right="4" top="4" bottom="4" />
          <TileSize val="16" />
          <EdgeSize val="16" />
        </Backdrop>
        <Scripts>
          <OnLoad>
            this:SetBackdropColor(0, 0, 0, 1)
          </OnLoad>
          <OnMouseUp>
            if SmartMailConfirmFrame and SmartMailConfirmFrame:IsVisible() then return end
            if SmartMailProfileEditorFrame and SmartMailProfileEditorFrame:IsVisible() then return end
            if SmartMail and SmartMail.selectedProfile then
              SmartMail.selectedProfile = nil
              SmartMail_UpdateProfileList()
            end
          </OnMouseUp>
        </Scripts>
        <Frames>
          <ScrollFrame name="$parentScrollFrame" inherits="UIPanelScrollFrameTemplate">
            <Anchors>
              <Anchor point="TOPLEFT">
                <Offset x="4" y="-4" />
              </Anchor>
              <Anchor point="BOTTOMRIGHT">
                <Offset x="-26" y="4" />
              </Anchor>
            </Anchors>
            <ScrollChild>
              <Frame name="$parentScrollChild">
                <Size x="250" y="212" />
              </Frame>
            </ScrollChild>
          </ScrollFrame>
        </Frames>
      </Frame>

      <!-- Middle Row -->
      <Button name="$parentSendAllButton" inherits="UIPanelButtonTemplate" text="Send All">
        <Size x="110" y="24" />
        <Anchors>
          <Anchor point="TOPLEFT" relativeTo="$parentListFrame" relativePoint="BOTTOMLEFT">
            <Offset x="0" y="-10" />
          </Anchor>
        </Anchors>
        <Scripts>
          <OnClick>
            SmartMail_SendAll()
          </OnClick>
        </Scripts>
      </Button>

      <Button name="$parentOpenSelectedButton" inherits="UIPanelButtonTemplate" text="Open Selected">
        <Size x="110" y="24" />
        <Anchors>
          <Anchor point="TOPRIGHT" relativeTo="$parentListFrame" relativePoint="BOTTOMRIGHT">
            <Offset x="0" y="-10" />
          </Anchor>
        </Anchors>
        <Scripts>
          <OnClick>
            if SmartMailConfirmFrame:IsVisible() then
              SmartMailConfirmFrame:Hide()
            else
              SmartMailConfirmFrame:Show()
            end
          </OnClick>
        </Scripts>
      </Button>

      <!-- Bottom Row -->
      <Button name="$parentOptionsButton" inherits="UIPanelButtonTemplate" text="Options">
        <Size x="110" y="24" />
        <Anchors>
          <Anchor point="BOTTOMLEFT">
            <Offset x="20" y="20" />
          </Anchor>
        </Anchors>
        <Scripts>
          <OnClick>
            if SmartMailOptionsFrame:IsVisible() then
              SmartMailOptionsFrame:Hide()
            else
              SmartMailOptionsFrame:Show()
            end
          </OnClick>
        </Scripts>
      </Button>

      <Button name="$parentLogButton" inherits="UIPanelButtonTemplate" text="Log Window">
        <Size x="110" y="24" />
        <Anchors>
          <Anchor point="BOTTOMRIGHT">
            <Offset x="-20" y="20" />
          </Anchor>
        </Anchors>
        <Scripts>
          <OnClick>
            if SmartMailLogFrame:IsVisible() then
              SmartMailLogFrame:Hide()
            else
              SmartMailLogFrame:Show()
            end
          </OnClick>
        </Scripts>
      </Button>
    </Frames>

    <Scripts>
      <OnLoad>
        this:RegisterForDrag("LeftButton")
      </OnLoad>
      <OnMouseUp>
        if SmartMailConfirmFrame and SmartMailConfirmFrame:IsVisible() then return end
        if SmartMailProfileEditorFrame and SmartMailProfileEditorFrame:IsVisible() then return end
        if SmartMail and SmartMail.selectedProfile then
          SmartMail.selectedProfile = nil
          SmartMail_UpdateProfileList()
        end
      </OnMouseUp>
      <OnDragStart>
        this:StartMoving()
      </OnDragStart>
      <OnDragStop>
        this:StopMovingOrSizing()
      </OnDragStop>
    </Scripts>
  </Frame>
  <!-- SmartMail Profile Editor Window -->
