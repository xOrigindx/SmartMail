<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ../FrameXML/UI.xsd">

  <Button name="SmartMailToggleButton" parent="MailFrame" inherits="UIPanelButtonTemplate"
    text="SmartMail">
    <Size x="85" y="22" />
    <Anchors>
      <Anchor point="TOPRIGHT" relativeTo="MailFrame" relativePoint="TOPRIGHT">
        <Offset x="-45" y="-14" />
      </Anchor>
    </Anchors>
    <Scripts>
      <OnClick>
        if SmartMailConfigFrame:IsVisible() then
        SmartMailConfigFrame:Hide()
        else
        SmartMailConfigFrame:Show()
        end
      </OnClick>
    </Scripts>
  </Button>

  <Frame name="SmartMailConfigFrame" toplevel="true" parent="UIParent" movable="true"
    enableMouse="true" hidden="true">
    <Size x="300" y="380" />
    <Anchors>
      <Anchor point="TOPLEFT" relativeTo="MailFrame" relativePoint="TOPRIGHT">
        <Offset x="10" y="0" />
      </Anchor>
    </Anchors>
    <Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background"
      edgeFile="Interface\DialogFrame\UI-DialogBox-Border" tile="true">
      <BackgroundInsets left="11" right="12" top="12" bottom="11" />
      <TileSize val="32" />
      <EdgeSize val="32" />
    </Backdrop>

    <Layers>
      <Layer level="ARTWORK">
        <Texture name="$parentHeader" file="Interface\DialogFrame\UI-DialogBox-Header">
          <Size x="256" y="64" />
          <Anchors>
            <Anchor point="TOP">
              <Offset x="0" y="12" />
            </Anchor>
          </Anchors>
        </Texture>
        <FontString name="$parentTitle" inherits="GameFontNormal" text="SmartMail Rules">
          <Anchors>
            <Anchor point="TOP" relativeTo="$parentHeader">
              <Offset x="0" y="-14" />
            </Anchor>
          </Anchors>
        </FontString>
      </Layer>
    </Layers>

    <Frames>
      <Button name="$parentCloseButton" inherits="UIPanelCloseButton">
        <Anchors>
          <Anchor point="TOPRIGHT">
            <Offset x="-5" y="-5" />
          </Anchor>
        </Anchors>
        <Scripts>
          <OnClick>
            this:GetParent():Hide()
          </OnClick>
        </Scripts>
      </Button>

      <Button name="SmartMailAddCharacterButton" inherits="UIPanelButtonTemplate"
        text="Add Character">
        <Size x="110" y="24" />
        <Anchors>
          <Anchor point="TOPLEFT">
            <Offset x="20" y="-45" />
          </Anchor>
        </Anchors>
        <Scripts>
          <OnClick>
            StaticPopup_Show("SMARTMAIL_ADD_CHARACTER")
          </OnClick>
        </Scripts>
      </Button>

      <Button name="SmartMailAddRuleButton" inherits="UIPanelButtonTemplate" text="Add Rule">
        <Size x="110" y="24" />
        <Anchors>
          <Anchor point="TOPLEFT" relativeTo="SmartMailAddCharacterButton" relativePoint="TOPRIGHT">
            <Offset x="10" y="0" />
          </Anchor>
        </Anchors>
        <Scripts>
          <OnClick>
            SmartMail_AddRule()
          </OnClick>
        </Scripts>
      </Button>

      <Frame name="SmartMailRulesListFrame">
        <Size x="260" y="270" />
        <Anchors>
          <Anchor point="BOTTOM">
            <Offset x="0" y="20" />
          </Anchor>
        </Anchors>
        <Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background"
          edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
          <BackgroundInsets left="4" right="4" top="4" bottom="4" />
          <TileSize val="16" />
          <EdgeSize val="16" />
        </Backdrop>
        <Scripts>
          <OnLoad>
            this:SetBackdropColor(0, 0, 0, 0.6)
          </OnLoad>
        </Scripts>
      </Frame>
    </Frames>

    <Scripts>
      <OnLoad>
        this:RegisterForDrag("LeftButton")
      </OnLoad>
      <OnDragStart>
        this:StartMoving()
      </OnDragStart>
      <OnDragStop>
        this:StopMovingOrSizing()
      </OnDragStop>
    </Scripts>
  </Frame>
</Ui>