<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ../FrameXML/UI.xsd">

  <!-- Generic Dialog Box Template -->
  <Frame name="SmartMailDialogTemplate" toplevel="true" enableMouse="true" movable="true" virtual="true">
    <Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background" edgeFile="Interface\DialogFrame\UI-DialogBox-Border" tile="true">
      <BackgroundInsets>
        <AbsInset left="11" right="12" top="12" bottom="11"/>
      </BackgroundInsets>
      <TileSize>
        <AbsValue val="32"/>
      </TileSize>
      <EdgeSize>
        <AbsValue val="32"/>
      </EdgeSize>
    </Backdrop>
    <Layers>
      <Layer level="ARTWORK">
        <FontString name="$parentTitle" inherits="GameFontNormal" text="Dialog Title">
          <Anchors>
            <Anchor point="TOP">
              <Offset x="0" y="-18"/>
            </Anchor>
          </Anchors>
        </FontString>
      </Layer>
    </Layers>
    <Frames>
      <Button name="$parentCloseXButton" inherits="UIPanelCloseButton">
        <Anchors>
          <Anchor point="TOPRIGHT">
            <Offset x="-5" y="-5"/>
          </Anchor>
        </Anchors>
      </Button>
    </Frames>
    <Scripts>
      <OnLoad>
        this:RegisterForDrag("LeftButton")
      </OnLoad>
      <OnDragStart>
        this:SetFrameStrata("HIGH")
        this:StartMoving()
      </OnDragStart>
      <OnDragStop>
        this:SetFrameStrata("MEDIUM")
        this:StopMovingOrSizing()
      </OnDragStop>
    </Scripts>
  </Frame>

  <!-- Generic List Row Template -->
  <Button name="SmartMailListRowTemplate" virtual="true">
    <Size>
      <AbsDimension x="200" y="20"/>
    </Size>
    <Layers>
      <Layer level="BACKGROUND">
        <Texture name="$parentSelection" file="Interface\QuestFrame\UI-QuestTitleHighlight" alphaMode="ADD" hidden="true">
          <Color r="0.8" g="0.8" b="1.0" a="0.5"/>
        </Texture>
      </Layer>
      <Layer level="ARTWORK">
        <FontString name="$parentText" inherits="GameFontNormalSmall" justifyH="LEFT">
          <Anchors>
            <Anchor point="LEFT">
              <Offset x="5" y="0"/>
            </Anchor>
          </Anchors>
        </FontString>
        <FontString name="$parentCategoryText" inherits="GameFontHighlightSmall" justifyH="RIGHT">
          <Anchors>
            <Anchor point="RIGHT">
              <Offset x="-5" y="0"/>
            </Anchor>
          </Anchors>
        </FontString>
        <Texture name="$parentHorizontalDivider">
          <Size x="240" y="1" />
          <Anchors>
            <Anchor point="BOTTOMLEFT">
              <Offset x="0" y="0"/>
            </Anchor>
          </Anchors>
          <Color r="1.0" g="1.0" b="0.0" a="0.3"/>
        </Texture>
      </Layer>
    </Layers>
    <HighlightTexture file="Interface\QuestFrame\UI-QuestTitleHighlight" alphaMode="ADD"/>

  </Button>
  <Button name="SmartMailToggleButton" parent="MailFrame" inherits="UIPanelButtonTemplate"
    text="SmartMail">
    <Size x="85" y="22" />
    <Anchors>
      <Anchor point="TOPRIGHT" relativeTo="MailFrame" relativePoint="TOPRIGHT">
        <Offset x="-75" y="-14" />
      </Anchor>
    </Anchors>
    <Scripts>
      <OnClick>
        SmartMail_Debug("SmartMailToggleButton clicked")
        if SmartMailMainFrame:IsVisible() then
          SmartMailMainFrame:Hide()
        else
          SmartMailMainFrame:Show()
        end
      </OnClick>
    </Scripts>
  </Button>

  <!-- SmartMail Main Window -->
  <Frame name="SmartMailMainFrame" inherits="SmartMailDialogTemplate" parent="UIParent" hidden="true">
    <Size x="320" y="420" />
    <Anchors>
      <Anchor point="TOPLEFT" relativeTo="MailFrame" relativePoint="TOPRIGHT">
        <Offset x="10" y="0" />
      </Anchor>
    </Anchors>
    <Frames>
      <Button name="$parentCloseButton" inherits="UIPanelCloseButton">
        <Anchors>
          <Anchor point="TOPRIGHT">
            <Offset x="-5" y="-5" />
          </Anchor>
        </Anchors>
        <Scripts>
          <OnClick>
            SmartMail_Debug("SmartMailMainFrameCloseButton clicked")
            SmartMail.forceCloseAll = true
            this:GetParent():Hide()
            if SmartMailLogFrame then SmartMailLogFrame:Hide() end
            if SmartMailCustomSendFrame then SmartMailCustomSendFrame:Hide() end
            if SmartMailCustomConfirmFrame then SmartMailCustomConfirmFrame:Hide() end
          </OnClick>
        </Scripts>
      </Button>

      <!-- Top Row -->
      <Button name="$parentAddButton" inherits="UIPanelButtonTemplate" text="Add">
        <Size x="80" y="24" />
        <Anchors>
          <Anchor point="TOPLEFT">
            <Offset x="20" y="-40" />
          </Anchor>
        </Anchors>
        <Scripts>
          <OnClick>
            SmartMail_Debug("SmartMailMainFrameAddButton clicked")
            SmartMail_OpenProfileEditor(nil)
          </OnClick>
        </Scripts>
      </Button>

      <Button name="$parentDeleteButton" inherits="UIPanelButtonTemplate" text="Delete">
        <Size x="80" y="24" />
        <Anchors>
          <Anchor point="TOP">
            <Offset x="0" y="-40" />
          </Anchor>
        </Anchors>
        <Scripts>
          <OnClick>
            SmartMail_Debug("SmartMailMainFrameDeleteButton clicked")
            if SmartMail.selectedProfile then
                SmartMail_DeleteProfile(SmartMail.selectedProfile)
            end
          </OnClick>
        </Scripts>
      </Button>

      <Button name="$parentEditButton" inherits="UIPanelButtonTemplate" text="Edit">
        <Size x="80" y="24" />
        <Anchors>
          <Anchor point="TOPRIGHT">
            <Offset x="-20" y="-40" />
          </Anchor>
        </Anchors>
        <Scripts>
          <OnClick>
            SmartMail_Debug("SmartMailMainFrameEditButton clicked")
            if SmartMail.selectedProfile then
                SmartMail_OpenProfileEditor(SmartMail.selectedProfile)
            end
          </OnClick>
        </Scripts>
      </Button>


      <!-- Character Name Area -->
      <Frame name="$parentListFrame" enableMouse="true">
        <Size x="280" y="220" />
        <Anchors>
          <Anchor point="TOP" relativeTo="$parentDeleteButton" relativePoint="BOTTOM">
            <Offset x="0" y="-10" />
          </Anchor>
        </Anchors>
        <Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background"
          edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
          <BackgroundInsets left="4" right="4" top="4" bottom="4" />
          <TileSize val="16" />
          <EdgeSize val="16" />
        </Backdrop>
        <Scripts>
          <OnLoad>
            this:SetBackdropColor(0, 0, 0, 1)
          </OnLoad>
          <OnMouseUp>
            if SmartMailConfirmFrame and SmartMailConfirmFrame:IsVisible() then return end
            if SmartMailProfileEditorFrame and SmartMailProfileEditorFrame:IsVisible() then return end
            if SmartMail and SmartMail.selectedProfile then
              SmartMail.selectedProfile = nil
              SmartMail_UpdateProfileList()
            end
          </OnMouseUp>
        </Scripts>
        <Frames>
          <ScrollFrame name="$parentScrollFrame" inherits="UIPanelScrollFrameTemplate">
            <Anchors>
              <Anchor point="TOPLEFT">
                <Offset x="4" y="-4" />
              </Anchor>
              <Anchor point="BOTTOMRIGHT">
                <Offset x="-26" y="4" />
              </Anchor>
            </Anchors>
            <ScrollChild>
              <Frame name="$parentScrollChild">
                <Size x="250" y="212" />
              </Frame>
            </ScrollChild>
          </ScrollFrame>
        </Frames>
      </Frame>

      <!-- Middle Row -->
      <Button name="$parentSendAllButton" inherits="UIPanelButtonTemplate" text="Send All">
        <Size x="90" y="24" />
        <Anchors>
          <Anchor point="TOPLEFT" relativeTo="$parentListFrame" relativePoint="BOTTOMLEFT">
            <Offset x="0" y="-10" />
          </Anchor>
        </Anchors>
        <Scripts>
          <OnClick>
            SmartMail_Debug("SmartMailMainFrameSendAllButton clicked")
            SmartMail_SendAll("ALL")
          </OnClick>
        </Scripts>
      </Button>

      <Button name="$parentSendAllFullButton" inherits="UIPanelButtonTemplate" text="Send All Full">
        <Size x="90" y="24" />
        <Anchors>
          <Anchor point="TOPRIGHT" relativeTo="$parentListFrame" relativePoint="BOTTOMRIGHT">
            <Offset x="0" y="-10" />
          </Anchor>
        </Anchors>
        <Scripts>
          <OnClick>
            SmartMail_Debug("SmartMailMainFrameSendAllFullButton clicked")
            SmartMail_SendAll("FULL")
          </OnClick>
        </Scripts>
      </Button>

      <!-- Bottom Row -->
      <Button name="$parentCustomSendButton" inherits="UIPanelButtonTemplate" text="Custom">
        <Size x="90" y="24" />
        <Anchors>
          <Anchor point="BOTTOM">
            <Offset x="0" y="20" />
          </Anchor>
        </Anchors>
        <Scripts>
          <OnClick>
            SmartMail_Debug("SmartMailMainFrameCustomSendButton clicked")
            if SmartMailCustomSendFrame and SmartMailCustomSendFrame:IsVisible() then
              SmartMailCustomSendFrame:Hide()
            else
              if SmartMailCustomSendFrame then SmartMailCustomSendFrame:Show() end
            end
          </OnClick>
        </Scripts>
      </Button>

      <Button name="$parentOptionsButton" inherits="UIPanelButtonTemplate" text="Options">
        <Size x="90" y="24" />
        <Anchors>
          <Anchor point="RIGHT" relativeTo="$parentCustomSendButton" relativePoint="LEFT">
            <Offset x="-5" y="0" />
          </Anchor>
        </Anchors>
        <Scripts>
          <OnClick>
            SmartMail_Debug("SmartMailMainFrameOptionsButton clicked")
            if SmartMailOptionsFrame:IsVisible() then
              SmartMailOptionsFrame:Hide()
            else
              SmartMailOptionsFrame:Show()
            end
          </OnClick>
        </Scripts>
      </Button>

      <Button name="$parentLogButton" inherits="UIPanelButtonTemplate" text="Log Window">
        <Size x="90" y="24" />
        <Anchors>
          <Anchor point="LEFT" relativeTo="$parentCustomSendButton" relativePoint="RIGHT">
            <Offset x="5" y="0" />
          </Anchor>
        </Anchors>
        <Scripts>
          <OnClick>
            SmartMail_Debug("SmartMailMainFrameLogButton clicked")
            if SmartMailLogFrame:IsVisible() and SmartMailLogMode ~= "DEBUG" then
              SmartMailLogFrame:Hide()
            else
              SmartMailLogMode = "ALL"
              if SmartMailLogFrameTitle then SmartMailLogFrameTitle:SetText("SmartMail Log Window") end
              SmartMailLogFrame:Show()
            end
          </OnClick>
        </Scripts>
      </Button>
    </Frames>

    <Scripts>
      <OnLoad>
        getglobal(this:GetName().."Title"):SetText("SmartMail")
        this:RegisterForDrag("LeftButton")
      </OnLoad>
      <OnMouseUp>
        if SmartMailConfirmFrame and SmartMailConfirmFrame:IsVisible() then return end
        if SmartMailProfileEditorFrame and SmartMailProfileEditorFrame:IsVisible() then return end
        if SmartMailCustomSendFrame and SmartMailCustomSendFrame:IsVisible() then return end
        if SmartMail and SmartMail.selectedProfile then
          SmartMail.selectedProfile = nil
          SmartMail_UpdateProfileList()
        end
      </OnMouseUp>
      <OnDragStart>
        this:SetFrameStrata("HIGH")
        this:StartMoving()
      </OnDragStart>
      <OnDragStop>
        this:SetFrameStrata("MEDIUM")
        this:StopMovingOrSizing()
      </OnDragStop>
    </Scripts>
  </Frame>
  <!-- SmartMail Profile Editor Window -->
  <Frame name="SmartMailProfileEditorFrame" inherits="SmartMailDialogTemplate" parent="UIParent" hidden="true">
    <Size x="510" y="440" />
    <Anchors>
      <Anchor point="CENTER" />
    </Anchors>
    <Layers>
      <Layer level="ARTWORK">
        <FontString name="$parentNameLabel" inherits="GameFontNormal" text="Character Name:">
          <Anchors>
            <Anchor point="TOPLEFT">
              <Offset x="20" y="-40" />
            </Anchor>
          </Anchors>
        </FontString>
      </Layer>
    </Layers>
    <Frames>
      <EditBox name="$parentNameEditBox" inherits="InputBoxTemplate" autoFocus="false">
        <Size x="150" y="20" />
        <Anchors>
          <Anchor point="TOPLEFT" relativeTo="$parentNameLabel" relativePoint="BOTTOMLEFT">
            <Offset x="5" y="-5" />
          </Anchor>
        </Anchors>
        <Scripts>
          <OnEscapePressed>
            SmartMail_Debug("Escape pressed in SmartMailProfileEditorFrameNameEditBox")
            this:ClearFocus()
          </OnEscapePressed>
        </Scripts>
      </EditBox>

      <!-- Available Categories -->
      <Frame name="$parentAvailableLabelFrame">
        <Size x="220" y="20"/>
        <Anchors>
          <Anchor point="TOPLEFT" relativeTo="$parentNameEditBox" relativePoint="BOTTOMLEFT">
            <Offset x="-5" y="-5" />
          </Anchor>
        </Anchors>
        <Layers>
          <Layer level="ARTWORK">
            <FontString name="$parentText" inherits="GameFontHighlightSmall" text="Available Categories" justifyH="CENTER">
              <Anchors>
                <Anchor point="CENTER"/>
              </Anchors>
              <Color r="1" g="1" b="0" />
            </FontString>
          </Layer>
        </Layers>
      </Frame>

      <Frame name="$parentAvailableListFrame" enableMouse="true">
        <Size x="220" y="280" />
        <Anchors>
          <Anchor point="TOPLEFT" relativeTo="$parentAvailableLabelFrame" relativePoint="BOTTOMLEFT">
            <Offset x="0" y="-5" />
          </Anchor>
        </Anchors>
        <Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background"
          edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
          <BackgroundInsets left="4" right="4" top="4" bottom="4" />
          <TileSize val="16" />
          <EdgeSize val="16" />
        </Backdrop>
        <Scripts>
          <OnLoad>
            this:SetBackdropColor(0, 0, 0, 1)
          </OnLoad>
        </Scripts>
        <Frames>
          <ScrollFrame name="$parentScrollFrame" inherits="UIPanelScrollFrameTemplate">
            <Anchors>
              <Anchor point="TOPLEFT">
                <Offset x="4" y="-4" />
              </Anchor>
              <Anchor point="BOTTOMRIGHT">
                <Offset x="-26" y="4" />
              </Anchor>
            </Anchors>
            <ScrollChild>
              <Frame name="$parentScrollChild">
                <Size x="190" y="300" />
              </Frame>
            </ScrollChild>
          </ScrollFrame>
        </Frames>
      </Frame>

      <!-- Active Categories -->
      <Frame name="$parentActiveLabelFrame">
        <Size x="220" y="20"/>
        <Anchors>
          <Anchor point="TOPLEFT" relativeTo="$parentAvailableLabelFrame" relativePoint="TOPRIGHT">
            <Offset x="10" y="0" />
          </Anchor>
        </Anchors>
        <Layers>
          <Layer level="ARTWORK">
            <FontString name="$parentText" inherits="GameFontHighlightSmall" text="Active Categories" justifyH="CENTER">
              <Anchors>
                <Anchor point="CENTER"/>
              </Anchors>
              <Color r="1" g="1" b="0" />
            </FontString>
          </Layer>
        </Layers>
      </Frame>

      <Frame name="$parentActiveListFrame" enableMouse="true">
        <Size x="220" y="280" />
        <Anchors>
          <Anchor point="TOPLEFT" relativeTo="$parentActiveLabelFrame" relativePoint="BOTTOMLEFT">
            <Offset x="0" y="-5" />
          </Anchor>
        </Anchors>
        <Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background"
          edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
          <BackgroundInsets left="4" right="4" top="4" bottom="4" />
          <TileSize val="16" />
          <EdgeSize val="16" />
        </Backdrop>
        <Scripts>
          <OnLoad>
            this:SetBackdropColor(0, 0, 0, 1)
          </OnLoad>
        </Scripts>
        <Frames>
          <ScrollFrame name="$parentScrollFrame" inherits="UIPanelScrollFrameTemplate">
            <Anchors>
              <Anchor point="TOPLEFT">
                <Offset x="4" y="-4" />
              </Anchor>
              <Anchor point="BOTTOMRIGHT">
                <Offset x="-26" y="4" />
              </Anchor>
            </Anchors>
            <ScrollChild>
              <Frame name="$parentScrollChild">
                <Size x="190" y="300" />
              </Frame>
            </ScrollChild>
          </ScrollFrame>
        </Frames>
      </Frame>

      <Button name="$parentCancelButton" inherits="UIPanelButtonTemplate" text="Cancel">
        <Size x="80" y="24" />
        <Anchors>
          <Anchor point="BOTTOMLEFT">
            <Offset x="20" y="20" />
          </Anchor>
        </Anchors>
        <Scripts>
          <OnClick>
            SmartMail_Debug("SmartMailProfileEditorFrameCancelButton clicked")
            this:GetParent():Hide()
          </OnClick>
        </Scripts>
      </Button>

      <Button name="$parentSaveButton" inherits="UIPanelButtonTemplate" text="Save">
        <Size x="80" y="24" />
        <Anchors>
          <Anchor point="BOTTOMRIGHT">
            <Offset x="-20" y="20" />
          </Anchor>
        </Anchors>
        <Scripts>
          <OnClick>
            SmartMail_Debug("SmartMailProfileEditorFrameSaveButton clicked")
            SmartMail_SaveProfile()
          </OnClick>
        </Scripts>
      </Button>
    </Frames>
    <Scripts>
      <OnLoad>
        getglobal(this:GetName().."Title"):SetText("Profile Editor")
        this:RegisterForDrag("LeftButton")
      </OnLoad>
      <OnDragStart>
        this:SetFrameStrata("HIGH")
        this:StartMoving()
      </OnDragStart>
      <OnDragStop>
        this:SetFrameStrata("MEDIUM")
        this:StopMovingOrSizing()
      </OnDragStop>
    </Scripts>
  </Frame>

  <!-- SmartMail Log Window -->
  <Frame name="SmartMailLogFrame" inherits="SmartMailDialogTemplate" parent="UIParent" hidden="true">
    <Size x="400" y="300" />
    <Anchors>
      <Anchor point="CENTER" />
    </Anchors>

    <Frames>

      <Frame name="$parentContentFrame">
        <Anchors>
          <Anchor point="TOPLEFT">
            <Offset x="20" y="-40" />
          </Anchor>
          <Anchor point="BOTTOMRIGHT">
            <Offset x="-20" y="50" />
          </Anchor>
        </Anchors>
        <Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background"
          edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
          <BackgroundInsets left="4" right="4" top="4" bottom="4" />
          <TileSize val="16" />
          <EdgeSize val="16" />
        </Backdrop>
        <Scripts>
          <OnLoad>
            this:SetBackdropColor(0, 0, 0, 0.6)
          </OnLoad>
        </Scripts>
        <Frames>
          <ScrollFrame name="$parentScrollFrame" inherits="UIPanelScrollFrameTemplate">
            <Anchors>
              <Anchor point="TOPLEFT">
                <Offset x="4" y="-4" />
              </Anchor>
              <Anchor point="BOTTOMRIGHT">
                <Offset x="-26" y="4" />
              </Anchor>
            </Anchors>
            <ScrollChild>
              <Frame name="$parentScrollChild">
                <Size x="280" y="150" />
                <Layers>
                  <Layer level="ARTWORK">
                    <FontString name="SmartMailLogFrameText" inherits="GameFontHighlightSmall" justifyH="LEFT" justifyV="TOP">
                      <Size x="260" y="0" />
                      <Anchors>
                        <Anchor point="TOPLEFT">
                          <Offset x="8" y="-8" />
                        </Anchor>
                      </Anchors>
                    </FontString>
                  </Layer>
                </Layers>
              </Frame>
            </ScrollChild>
          </ScrollFrame>
        </Frames>
      </Frame>

      <Button name="$parentClearButton" inherits="UIPanelButtonTemplate" text="Clear">
        <Size x="65" y="24" />
        <Anchors>
          <Anchor point="BOTTOMLEFT">
            <Offset x="20" y="20" />
          </Anchor>
        </Anchors>
        <Scripts>
          <OnClick>
            SmartMail_Debug("SmartMailLogFrameClearButton clicked")
            StaticPopup_Show("SMARTMAIL_CLEAR_LOG")
          </OnClick>
        </Scripts>
      </Button>

      <Button name="$parentTabIn" inherits="UIPanelButtonTemplate" text="In">
        <Size x="45" y="24" />
        <Anchors>
          <Anchor point="BOTTOM">
            <Offset x="0" y="20" />
          </Anchor>
        </Anchors>
        <Scripts>
          <OnClick>
            SmartMail_Debug("SmartMailLogFrameTabIn clicked")
            SmartMailLogMode = "INCOMING"
            SmartMail_UpdateLogFrame()
          </OnClick>
        </Scripts>
      </Button>

      <Button name="$parentTabAll" inherits="UIPanelButtonTemplate" text="All">
        <Size x="45" y="24" />
        <Anchors>
          <Anchor point="RIGHT" relativeTo="$parentTabIn" relativePoint="LEFT">
            <Offset x="-5" y="0" />
          </Anchor>
        </Anchors>
        <Scripts>
          <OnClick>
            SmartMail_Debug("SmartMailLogFrameTabAll clicked")
            SmartMailLogMode = "ALL"
            SmartMail_UpdateLogFrame()
          </OnClick>
        </Scripts>
      </Button>
      
      <Button name="$parentTabOut" inherits="UIPanelButtonTemplate" text="Out">
        <Size x="45" y="24" />
        <Anchors>
          <Anchor point="LEFT" relativeTo="$parentTabIn" relativePoint="RIGHT">
            <Offset x="5" y="0" />
          </Anchor>
        </Anchors>
        <Scripts>
          <OnClick>
            SmartMail_Debug("SmartMailLogFrameTabOut clicked")
            SmartMailLogMode = "OUTGOING"
            SmartMail_UpdateLogFrame()
          </OnClick>
        </Scripts>
      </Button>

      <Button name="$parentCloseButton" inherits="UIPanelButtonTemplate" text="Close">
        <Size x="65" y="24" />
        <Anchors>
          <Anchor point="BOTTOMRIGHT">
            <Offset x="-20" y="20" />
          </Anchor>
        </Anchors>
        <Scripts>
          <OnClick>
            SmartMail_Debug("SmartMailLogFrameCloseButton clicked")
            this:GetParent():Hide()
          </OnClick>
        </Scripts>
      </Button>
    </Frames>
    <Scripts>
      <OnLoad>
        getglobal(this:GetName().."Title"):SetText("SmartMail Log Window")
        this:RegisterForDrag("LeftButton")
      </OnLoad>
      <OnDragStart>
        this:SetFrameStrata("HIGH")
        this:StartMoving()
      </OnDragStart>
      <OnDragStop>
        this:SetFrameStrata("MEDIUM")
        this:StopMovingOrSizing()
      </OnDragStop>
    </Scripts>
  </Frame>

  <!-- SmartMail Debug Window -->
  <Frame name="SmartMailDebugFrame" inherits="SmartMailDialogTemplate" parent="UIParent" hidden="true">
    <Size x="450" y="350" />
    <Anchors>
      <Anchor point="BOTTOMRIGHT">
        <Offset x="-20" y="20"/>
      </Anchor>
    </Anchors>
    <Frames>
      <Frame name="SmartMailDebugCategoryDropDown" inherits="UIDropDownMenuTemplate">
        <Anchors>
          <Anchor point="TOPLEFT">
            <Offset x="-5" y="-30" />
          </Anchor>
        </Anchors>
        <Scripts>
          <OnLoad>
            UIDropDownMenu_Initialize(this, SmartMailDebugCategoryDropDown_Initialize)
            UIDropDownMenu_SetWidth(150, this)
            UIDropDownMenu_SetSelectedValue(this, 1)
            UIDropDownMenu_SetText("ALL", this)
          </OnLoad>
          <OnShow>
            UIDropDownMenu_Initialize(this, SmartMailDebugCategoryDropDown_Initialize)
          </OnShow>
        </Scripts>
      </Frame>
      <Frame name="$parentContentFrame">
        <Anchors>
          <Anchor point="TOPLEFT">
            <Offset x="20" y="-65" />
          </Anchor>
          <Anchor point="BOTTOMRIGHT">
            <Offset x="-20" y="50" />
          </Anchor>
        </Anchors>
        <Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background" edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
          <BackgroundInsets left="4" right="4" top="4" bottom="4" />
          <TileSize val="16" />
          <EdgeSize val="16" />
        </Backdrop>
        <Scripts>
          <OnLoad>
            this:SetBackdropColor(0, 0, 0, 0.8)
          </OnLoad>
        </Scripts>
        <Frames>
          <ScrollFrame name="$parentScrollFrame" inherits="FauxScrollFrameTemplate">
            <Anchors>
              <Anchor point="TOPLEFT">
                <Offset x="4" y="-4" />
              </Anchor>
              <Anchor point="BOTTOMRIGHT">
                <Offset x="-26" y="4" />
              </Anchor>
            </Anchors>
            <Scripts>
              <OnVerticalScroll>
                FauxScrollFrame_OnVerticalScroll(14, SmartMail_UpdateDebugList)
              </OnVerticalScroll>
            </Scripts>
          </ScrollFrame>
        </Frames>
      </Frame>
      <Button name="$parentUnselectButton" inherits="UIPanelButtonTemplate" text="Unselect">
        <Size x="100" y="24" />
        <Anchors>
          <Anchor point="BOTTOMLEFT">
            <Offset x="20" y="20" />
          </Anchor>
        </Anchors>
        <Scripts>
