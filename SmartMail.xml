  <!-- SmartMail Copy Popup -->
  <Frame name="SmartMailCopyFrame" toplevel="true" parent="UIParent" movable="true" enableMouse="true" hidden="true">
    <Size x="450" y="350" />
    <Anchors>
      <Anchor point="CENTER">
        <Offset x="0" y="0" />
      </Anchor>
    </Anchors>
    <Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background" edgeFile="Interface\DialogFrame\UI-DialogBox-Border" tile="true">
      <BackgroundInsets left="11" right="12" top="12" bottom="11" />
      <TileSize val="32" />
      <EdgeSize val="32" />
    </Backdrop>
    <Layers>
      <Layer level="ARTWORK">
        <FontString name="$parentTitle" inherits="GameFontNormal" text="Copy Debug Log">
          <Anchors>
            <Anchor point="TOP">
              <Offset x="0" y="-15" />
            </Anchor>
          </Anchors>
        </FontString>
      </Layer>
    </Layers>
    <Frames>
      <ScrollFrame name="$parentScrollFrame" inherits="UIPanelScrollFrameTemplate">
        <Size x="400" y="260" />
        <Anchors>
          <Anchor point="TOPLEFT">
            <Offset x="15" y="-35" />
          </Anchor>
        </Anchors>
        <ScrollChild>
          <EditBox name="SmartMailCopyFrameText" multiLine="true" autoFocus="true" enableMouse="true">
            <Size x="390" y="260" />
            <Anchors>
              <Anchor point="TOPLEFT">
                <Offset x="0" y="0" />
              </Anchor>
            </Anchors>
            <Scripts>
              <OnLoad>
                this:SetFontObject("GameFontHighlightSmall")
              </OnLoad>
              <OnEscapePressed>
                SmartMail_Debug("Escape pressed in SmartMailCopyFrameText")
                this:ClearFocus()
              </OnEscapePressed>
            </Scripts>
          </EditBox>
        </ScrollChild>
      </ScrollFrame>
      <Button name="$parentCloseButton" inherits="UIPanelButtonTemplate" text="Close">
        <Size x="100" y="24" />
        <Anchors>
          <Anchor point="BOTTOM">
